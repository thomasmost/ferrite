#
# Pebble app build script, customized for Ferrite: the app's code is Rust,
# compiled by cargo into a static library that is linked into the app ELF
# via the SDK's stlib mechanism. See the repo README.
#
import os
import subprocess

top = '.'
out = 'build'

CARGO_TARGET = 'thumbv7m-none-eabi'
# Cargo crate name = staticlib name (libhello.a). Template users: change
# this alongside [package] name in Cargo.toml.
RUST_CRATE = 'hello'

# Codegen flags the Pebble loader requires. These are NOT optional:
#
#   relocation-model=pic   Pebble apps are loaded at an address chosen at
#                          runtime. The firmware fixes up pointers using a
#                          relocation table that inject_metadata.py builds
#                          from the ELF's .rel.data section and .got only --
#                          it never touches .text. Without PIC, LLVM
#                          materializes addresses of statics directly into
#                          Thumb instructions (movw/movt ABS), which nothing
#                          fixes up: every &'static pointer is then garbage
#                          at runtime and the app faults on first use.
#   force-unwind-tables=no Keeps .ARM.extab/.ARM.exidx from growing, which
#                          inject_metadata.py does not expect.
#
# They live here rather than only in .cargo/config.toml because a RUSTFLAGS
# environment variable (common in developer shells) silently overrides
# [target.*] rustflags from config.toml -- which produced exactly the
# broken-pointer failure above. Inherited flags are kept, but ours are
# appended last so they win.
REQUIRED_RUSTFLAGS = [
    '-C', 'relocation-model=pic',
    '-C', 'force-unwind-tables=no',
]


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    ctx.load('pebble_sdk')


def _cargo_path():
    cargo = os.path.expanduser('~/.cargo/bin/cargo')
    return cargo if os.path.exists(cargo) else 'cargo'


def _cargo_env():
    """Environment for cargo, with REQUIRED_RUSTFLAGS appended to RUSTFLAGS."""
    env = os.environ.copy()
    # CARGO_ENCODED_RUSTFLAGS takes precedence over RUSTFLAGS if both are set,
    # so it has to be extended rather than left to shadow what we add.
    if 'CARGO_ENCODED_RUSTFLAGS' in env:
        inherited = [f for f in env.pop('CARGO_ENCODED_RUSTFLAGS').split('\x1f') if f]
    else:
        inherited = env.get('RUSTFLAGS', '').split()
    env['CARGO_ENCODED_RUSTFLAGS'] = '\x1f'.join(inherited + REQUIRED_RUSTFLAGS)
    env.pop('RUSTFLAGS', None)
    return env


# Relocation types that bake an absolute address into the loaded image.
# readelf truncates the two Thumb names, hence the '_AB' suffixes.
ABSOLUTE_RELOC_TYPES = (
    'R_ARM_ABS32',
    'R_ARM_THM_MOVW_AB',   # R_ARM_THM_MOVW_ABS_NC
    'R_ARM_THM_MOVT_AB',   # R_ARM_THM_MOVT_ABS
)

# Relocation sections that are legitimately allowed to contain absolute
# entries, by prefix:
#   .rel.data / .got      inject_metadata.py emits load-time fixups for these
#                         (see its get_relocate_entries: it prefix-matches
#                         '.rel.data' and adds the whole .got range)
#   .rel.ARM.exidx        PREL31 is self-relative, so nothing to fix up
#   .rel.debug, .rel.comment, .rel.ARM.attributes
#                         non-allocated; never loaded, so their absolute
#                         entries are inert (there are ~1100 of them)
RELOC_SECTIONS_EXEMPT = (
    '.rel.data',
    '.got',
    '.rel.ARM.exidx',
    '.rel.debug',
    '.rel.comment',
    '.rel.ARM.attributes',
)


def _check_relocations(elf, readelf):
    """Fail loudly if the linked app has absolute relocations in loaded code.

    inject_metadata.py only emits load-time fixups for .rel.data and .got, so
    an absolute relocation anywhere else that is actually loaded is a pointer
    that never gets corrected. This guards against the required rustflags
    silently not applying.

    Note: this checks .rel.text and .rel.rodata separately even though the
    SDK's linker script currently folds .rodata into .text -- so the ELF has
    no distinct .rodata section today. Checking by prefix means the guard
    keeps working if that ever changes.
    """
    out = subprocess.check_output([readelf, '-r', elf]).decode('utf8', 'replace')
    bad = []
    section, checking = None, False
    for line in out.splitlines():
        if line.startswith('Relocation section'):
            # "Relocation section '.rel.text' at offset 0x... contains N entries:"
            start = line.find("'")
            end = line.find("'", start + 1) if start != -1 else -1
            section = line[start + 1:end] if end != -1 else ''
            checking = not section.startswith(RELOC_SECTIONS_EXEMPT)
            continue
        if not checking:
            continue
        # Entry format: "000000e0  0000990a R_ARM_THM_CALL   00000df9   symbol"
        # Match on the type column only -- a substring test would also hit
        # symbol names, and Rust v0 mangling can embed '_AB' in those.
        parts = line.split()
        if len(parts) >= 3 and parts[2] in ABSOLUTE_RELOC_TYPES:
            bad.append((section, line.strip()))
    if bad:
        from waflib import Errors
        shown = '\n'.join('  {}: {}'.format(s, l) for s, l in bad[:5])
        raise Errors.WafError(
            '{} has {} absolute relocation(s) in loaded sections that the '
            'Pebble loader cannot fix up -- static pointers would be garbage '
            'at runtime.\n'
            'The required rustflags ({}) did not reach rustc.\n'
            'First offenders:\n{}'.format(
                elf, len(bad), ' '.join(REQUIRED_RUSTFLAGS), shown))


def build(ctx):
    ctx.load('pebble_sdk')

    # Compile the Rust staticlib (target/thumbv7m-none-eabi/release/libhello.a).
    subprocess.check_call(
        [_cargo_path(), 'build', '--release', '--target', CARGO_TARGET],
        cwd=ctx.path.abspath(), env=_cargo_env())
    rust_lib_dir = os.path.join(
        ctx.path.abspath(), 'target', CARGO_TARGET, 'release')
    rust_lib = os.path.join(rust_lib_dir, 'lib{}.a'.format(RUST_CRATE))

    binaries = []
    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        # source glob matches nothing: all app code is Rust. The SDK still
        # appends its generated appinfo.auto.c / resource_ids.auto.c.
        # -u main forces extraction of the Rust-provided entry point from
        # the archive (nothing else references it).
        ctx.pbl_build(source=ctx.path.ant_glob('src/c/**/*.c'),
                      target=app_elf,
                      bin_type='app',
                      stlib=[RUST_CRATE],
                      stlibpath=[rust_lib_dir],
                      linkflags=['-Wl,-u,main'])
        # waf only sees stlib as -L/-l flags, not as a link input: without
        # this, editing Rust source can silently produce a stale .pbw.
        ctx.add_manual_dependency(
            ctx.path.find_or_declare(app_elf),
            ctx.root.make_node(rust_lib))
        binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env

    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=ctx.path.ant_glob(['src/pkjs/**/*.js',
                                         'src/pkjs/**/*.json',
                                         'src/common/**/*.js']),
                   js_entry_file='src/pkjs/index.js')

    # Verify relocations in a post-function (after bundling).
    # If verification fails, delete the .pbw and .bin artifacts so a developer
    # cannot accidentally install a broken app. The _verify function runs with
    # the actual build context, so the ELF files exist by then.
    def _discard_artifacts(bld):
        """Remove installable output so a failed check cannot ship a bad app.

        pebble install does not re-verify; without this, a developer who
        misses the error at the tail of the build output would install the
        bundle produced moments earlier.
        """
        import glob
        for pbw in glob.glob(os.path.join(bld.bldnode.abspath(), '*.pbw')):
            os.remove(pbw)
        for binary in binaries:
            app_bin = os.path.join(
                bld.bldnode.abspath(),
                os.path.dirname(binary['app_elf']), 'pebble-app.bin')
            if os.path.exists(app_bin):
                os.remove(app_bin)

    def _verify(bld):
        from waflib import Errors
        for binary in binaries:
            node = bld.bldnode.find_node(binary['app_elf'])
            if not node:
                _discard_artifacts(bld)
                raise Errors.WafError(
                    'relocation check could not find {} -- the BUILD_DIR '
                    'layout may have changed. Refusing to report success for '
                    'an unverified binary.'.format(binary['app_elf']))
            try:
                _check_relocations(node.abspath(), 'arm-none-eabi-readelf')
            except Errors.WafError:
                _discard_artifacts(bld)
                raise

    ctx.add_post_fun(_verify)
